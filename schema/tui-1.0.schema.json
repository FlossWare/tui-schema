{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlossWare/tui-schema/schema/1.0",
  "title": "FlossWare TUI Schema 1.0",
  "description": "Language-neutral declarative schema for terminal user interfaces. Implementations interpret this contract; the schema contains no executable behavior.",
  "type": "object",
  "required": ["schema", "id", "title", "windows"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "flossware.tui/1.0" },
    "id": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1 },
    "theme": { "$ref": "#/$defs/theme" },
    "menus": { "type": "array", "items": { "$ref": "#/$defs/menu" }, "minItems": 1 },
    "windows": { "type": "array", "items": { "$ref": "#/$defs/window" }, "minItems": 1 }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "accelerator": { "type": "string", "pattern": "^[A-Za-z0-9]$" },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "layout": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 },
        "minWidth": { "type": "integer", "minimum": 1 }, "minHeight": { "type": "integer", "minimum": 1 },
        "maxWidth": { "type": "integer", "minimum": 1 }, "maxHeight": { "type": "integer", "minimum": 1 },
        "anchor": { "enum": ["top-left", "top-right", "bottom-left", "bottom-right", "center"] }
      }
    },
    "menu": {
      "type": "object", "required": ["id", "label", "items"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }, "label": { "type": "string", "minLength": 1 },
        "accelerator": { "$ref": "#/$defs/accelerator" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/menuItem" }, "minItems": 1 }
      }
    },
    "menuItem": { "oneOf": [{ "$ref": "#/$defs/menuActionItem" }, { "$ref": "#/$defs/menuSeparator" }] },
    "menuActionItem": {
      "type": "object", "required": ["id", "label", "action"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }, "label": { "type": "string", "minLength": 1 },
        "accelerator": { "$ref": "#/$defs/accelerator" }, "action": { "$ref": "#/$defs/action" },
        "enabled": { "type": "boolean", "default": true }, "visible": { "type": "boolean", "default": true }
      }
    },
    "menuSeparator": {
      "type": "object", "required": ["id", "type"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/identifier" }, "type": { "const": "separator" }, "visible": { "type": "boolean", "default": true } }
    },
    "window": {
      "type": "object", "required": ["id", "kind", "content"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }, "kind": { "enum": ["window", "dialog", "popup", "panel"] },
        "title": { "type": "string" }, "modal": { "type": "boolean", "default": false },
        "movable": { "type": "boolean", "default": true }, "resizable": { "type": "boolean", "default": true },
        "menuBar": { "$ref": "#/$defs/identifier" }, "defaultAction": { "$ref": "#/$defs/action" },
        "cancelAction": { "$ref": "#/$defs/action" }, "initialFocus": { "$ref": "#/$defs/identifier" },
        "layout": { "$ref": "#/$defs/layout" }, "content": { "type": "array", "items": { "$ref": "#/$defs/widget" } }
      }
    },
    "widget": { "oneOf": [
      { "$ref": "#/$defs/label" }, { "$ref": "#/$defs/textInput" }, { "$ref": "#/$defs/checkbox" },
      { "$ref": "#/$defs/list" }, { "$ref": "#/$defs/button" }, { "$ref": "#/$defs/separatorWidget" }, { "$ref": "#/$defs/group" }
    ] },
    "widgetCommon": {
      "type": "object", "required": ["id", "type"], "properties": {
        "id": { "$ref": "#/$defs/identifier" }, "type": {},
        "enabled": { "type": "boolean", "default": true }, "visible": { "type": "boolean", "default": true },
        "layout": { "$ref": "#/$defs/layout" }
      }
    },
    "label": { "allOf": [
      { "$ref": "#/$defs/widgetCommon" },
      { "required": ["label"], "properties": { "type": { "const": "label" }, "label": { "type": "string", "minLength": 1 }, "focusable": { "const": false } } },
      { "unevaluatedProperties": false }
    ] },
    "textInput": { "allOf": [
      { "$ref": "#/$defs/widgetCommon" },
      { "required": ["value"], "properties": {
        "type": { "const": "text-input" }, "label": { "type": "string" }, "value": { "type": "string" },
        "action": { "$ref": "#/$defs/action" }, "focusable": { "type": "boolean", "default": true }
      } },
      { "unevaluatedProperties": false }
    ] },
    "checkbox": { "allOf": [
      { "$ref": "#/$defs/widgetCommon" },
      { "properties": {
        "type": { "const": "checkbox" }, "label": { "type": "string" }, "value": { "type": "boolean", "default": false },
        "action": { "$ref": "#/$defs/action" }, "accelerator": { "$ref": "#/$defs/accelerator" }, "focusable": { "type": "boolean", "default": true }
      } },
      { "unevaluatedProperties": false }
    ] },
    "listItem": {
      "type": "object", "required": ["id", "label"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/identifier" }, "label": { "type": "string", "minLength": 1 }, "value": {}, "enabled": { "type": "boolean", "default": true } }
    },
    "list": { "allOf": [
      { "$ref": "#/$defs/widgetCommon" },
      { "required": ["items"], "properties": {
        "type": { "const": "list" }, "label": { "type": "string" }, "items": { "type": "array", "items": { "$ref": "#/$defs/listItem" }, "minItems": 1 },
        "selected": { "$ref": "#/$defs/identifier" }, "action": { "$ref": "#/$defs/action" }, "focusable": { "type": "boolean", "default": true }
      } },
      { "unevaluatedProperties": false }
    ] },
    "button": { "allOf": [
      { "$ref": "#/$defs/widgetCommon" },
      { "required": ["label", "action"], "properties": {
        "type": { "const": "button" }, "label": { "type": "string", "minLength": 1 }, "action": { "$ref": "#/$defs/action" },
        "accelerator": { "$ref": "#/$defs/accelerator" }, "focusable": { "type": "boolean", "default": true }
      } },
      { "unevaluatedProperties": false }
    ] },
    "separatorWidget": { "allOf": [
      { "$ref": "#/$defs/widgetCommon" },
      { "properties": { "type": { "const": "separator" } } },
      { "unevaluatedProperties": false }
    ] },
    "group": { "allOf": [
      { "$ref": "#/$defs/widgetCommon" },
      { "required": ["children"], "properties": {
        "type": { "const": "group" }, "label": { "type": "string" }, "children": { "type": "array", "items": { "$ref": "#/$defs/widget" }, "minItems": 1 }
      } },
      { "unevaluatedProperties": false }
    ] },
    "theme": { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 } } }
  }
}
