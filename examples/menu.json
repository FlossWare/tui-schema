{
  "schema": "flossware.tui/1.0",
  "id": "example-menu",
  "title": "Example Menu",
  "theme": { "name": "default" },
  "menus": [
    {
      "id": "main-menu",
      "label": "Main",
      "items": [
        { "id": "profiles", "label": "Profiles", "accelerator": "p", "action": "profiles" },
        { "id": "menu-separator", "type": "separator" },
        { "id": "quit", "label": "Quit", "accelerator": "q", "action": "quit" }
      ]
    }
  ],
  "windows": [
    {
      "id": "main",
      "kind": "window",
      "title": "Example",
      "menuBar": "main-menu",
      "layout": { "x": 0, "y": 0, "width": 80, "height": 24 },
      "initialFocus": "configure",
      "content": [
        { "id": "status", "type": "label", "label": "Ready" },
        { "id": "configure", "type": "button", "label": "Configure", "accelerator": "c", "action": "configure" }
      ]
    }
  ]
}
